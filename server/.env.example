[TEMPLATE]
# ---- Neon Postgres ----
# Pooled connection string from console.neon.tech (Connection Details → Pooled)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---- Neon Auth ----
# Auth Base URL from the Neon Console → Auth → Configuration
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth

# ---- Neon Object Storage ----
# Run `neon env pull` to fill these automatically, or create a credential with:
#   neon credentials create --scope storage:read --scope storage:write --name goodpost
AWS_REGION=us-east-2
AWS_ENDPOINT_URL_S3=https://<branch-id>.storage.c-<n>.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_BUCKET=goodpost
# Optional — defaults to ${AWS_ENDPOINT_URL_S3}/${STORAGE_BUCKET}
STORAGE_PUBLIC_BASE_URL=

# ---- Server ----
PORT=8080
# Comma-separated. Must NOT be "*" in production or the server refuses to boot.
CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# ---- Image moderation (runs inside this API — no separate service to deploy) ----
# The NSFW model uses ~160 MB resident, which fits Render's free 512 MB tier.
MODERATION_ENABLED=true
# "closed" rejects an upload when the model can't run; "open" lets it through.
MODERATION_FAIL_POLICY=closed
MODERATION_PORN_THRESHOLD=0.7
MODERATION_HENTAI_THRESHOLD=0.7
MODERATION_SEXY_THRESHOLD=0.8
# Optional: point at a self-hosted copy of the model instead of the nsfwjs CDN.
MODERATION_MODEL_URL=

# ---- Admin bootstrap ----
# Comma-separated emails that are promoted to admin automatically on first login.
ADMIN_EMAILS=you@example.com

# ---- Error tracking (optional) ----
# Leave blank to disable Sentry; the in-process counters always stay active.
SENTRY_DSN=
