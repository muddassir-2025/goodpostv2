# Copy this file to `.env` and fill in the values.

# URL of the Render backend (no trailing slash)
VITE_API_URL=http://localhost:8080

# Neon Auth Base URL — Neon Console → Project → Auth → Configuration
VITE_NEON_AUTH_URL=https://ep-xxx.neonauth.region.aws.neon.build/neondb/auth

# Public base URL for Neon Object Storage (public_read bucket), no trailing slash.
# This is `${AWS_ENDPOINT_URL_S3}/${STORAGE_BUCKET}`, e.g.
# https://<branch-id>.storage.c-1.us-east-2.aws.neon.tech/goodpost
VITE_STORAGE_PUBLIC_URL=https://<branch-id>.storage.c-1.us-east-2.aws.neon.tech/goodpost
